{
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" }
  },
  "font-size": {
    "xs": { "$value": "12px", "$type": "dimension" },
    "sm": { "$value": "14px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "20px", "$type": "dimension" },
    "xl": { "$value": "28px", "$type": "dimension" },
    "2xl": { "$value": "40px", "$type": "dimension" },
    "3xl": { "$value": "64px", "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "$description": "UI chrome uses fast/base. Reward moments use slow/celebrate/count.",
      "instant": { "$value": "80ms", "$type": "duration" },
      "fast": { "$value": "160ms", "$type": "duration" },
      "base": { "$value": "240ms", "$type": "duration" },
      "slow": { "$value": "420ms", "$type": "duration" },
      "celebrate": { "$value": "900ms", "$type": "duration" },
      "count": { "$value": "1200ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": [0.2, 0, 0, 1], "$type": "cubicBezier" },
      "out": { "$value": [0.16, 1, 0.3, 1], "$type": "cubicBezier" },
      "in": { "$value": [0.7, 0, 0.84, 0], "$type": "cubicBezier" },
      "overshoot": { "$value": [0.34, 1.56, 0.64, 1], "$type": "cubicBezier" }
    },
    "chest": {
      "$description": "Choreography of the chest opening. Brands may NOT override these: timing and feel are shared.",
      "anticipate": { "$value": "{motion.duration.fast}", "$type": "duration" },
      "lid": { "$value": "{motion.duration.slow}", "$type": "duration" },
      "burst": { "$value": "{motion.duration.celebrate}", "$type": "duration" },
      "count": { "$value": "{motion.duration.count}", "$type": "duration" },
      "coin-stagger": { "$value": "30ms", "$type": "duration" },
      "spark-delay": { "$value": "120ms", "$type": "duration" },
      "spark-stagger": { "$value": "70ms", "$type": "duration" },
      "ray-spin": { "$value": "28000ms", "$type": "duration" }
    },
    "level": {
      "$description": "Level bar: the fill glides, the level badge pops when the level changes.",
      "fill": { "$value": "{motion.duration.slow}", "$type": "duration" },
      "pop": { "$value": "{motion.duration.celebrate}", "$type": "duration" }
    },
    "streak": {
      "$description": "Daily streak: today's tile pulses once, the check mark draws itself.",
      "pulse": { "$value": "{motion.duration.celebrate}", "$type": "duration" },
      "check": { "$value": "{motion.duration.slow}", "$type": "duration" }
    }
  }
}
