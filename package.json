{
  "name": "reward-kit",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && npm run check && npm run catalog && npm run spec && npm run test && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/check-styles.mjs",
    "spec": "node scripts/build-motion-spec.mjs",
    "test": "vitest run",
    "catalog": "node scripts/build-catalog.mjs",
    "template:new": "node scripts/new-template.mjs",
    "template:verify": "node scripts/verify-template.mjs",
    "template:abandon": "node scripts/abandon-template.mjs",
    "template:review": "node scripts/review-template.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
